    {
      "id": "stalwart",
      "name": "Stalwart",
      "category": "Passive",
      "text": "A model with this rule may re-roll one failed Courage test per turn."
    },
    {
      "id": "hold-the-line",
      "name": "Hold the Line",
      "category": "Passive",
      "text": "Friendly warriors within 3\" of a model with this rule count as being in a shieldwall."
    },
    {
      "id": "terror",
      "name": "Terror",
      "category": "Active",
      "text": "Enemy models in contact must pass a Courage test before fighting this model, or fight at half their Fight value."
    },
    {
      "id": "brutal-charge",
      "name": "Brutal Charge",
      "category": "Active",
      "text": "On the turn this model charges, it gains +1 Strength on its first strike."
    },
    {
      "id": "hex",
      "name": "Hex",
      "category": "Magic",
      "text": "Range 12\". Target an enemy model; it suffers -1 to its Fight value until the end of the turn."
    },
    {
      "id": "mend",
      "name": "Mend",
      "category": "Magic",
      "text": "Range 6\". Target a friendly hero; it recovers one lost Wound."
    },
    {
      "id": "light-footed",
      "name": "Light Footed",
      "category": "Passive",
      "text": "This model ignores difficult terrain when moving."
    },
    {
      "id": "pack-tactics",
      "name": "Pack Tactics",
      "category": "Passive",
      "text": "Gains +1 to its Fight value while two or more friendly models are in contact with the same enemy."
